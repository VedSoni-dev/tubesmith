{
  "name": "QuietFeed",
  "tagline": "Videos people I trust actually recommended.",

  "sources": {
    "hn": {
      "enabled": true,
      "since": "2007-01-01",
      "min_text_chars": 100,
      "min_people": 3,
      "min_months": 3,
      "max_mentions": 20
    },
    "channels": {
      "enabled": false,
      "list": ["@3blue1brown", "UCYO_jab_esuFRV4b17AJtAw"],
      "per_channel": 15
    },
    "custom": {
      "enabled": false,
      "files": ["data/mentions.reddit.jsonl"],
      "min_people": 2,
      "min_months": 2
    },
    "seeds": ["https://www.youtube.com/watch?v=SxdOUGdseq4"]
  },

  "taste": {
    "more_of": "deep technical talks, history documentaries, people building things with their hands",
    "never": "reaction videos, drama, influencer gossip, crypto hype",
    "examples": [],
    "block_channels": [],
    "block_keywords": []
  },

  "rules": {
    "hide_shorts": true,
    "drop_clickbait": false,
    "clickbait_max": 2,
    "hide_stale_news": false,
    "min_rec_people": 2,
    "min_minutes": 0,
    "max_minutes": 0
  },

  "display": {
    "thumbnails": "mid",
    "titles": "original",
    "why_tooltip": true,
    "longs_shelf": true,
    "gems_shelf": true,
    "hide_counts": false,
    "finite_feed": 0,
    "accent": "#4f8cff",
    "credits": "Recommendations from Hacker News commenters. Video data from YouTube."
  },

  "judge": {
    "mode": "agent",
    "batch_size": 25,
    "concurrency": 8
  },

  "youtube": {
    "api_key_env": "YOUTUBE_API_KEY"
  },

  "deploy": "local"
}
